rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function real() { return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    function me(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return signedIn() && request.auth.token.email_verified == true &&
        request.auth.token.email in ['unitedmodelsindia@gmail.com','wowglamentertainment@gmail.com','acecraftmedia@gmail.com'];
    }
    function isMgr() {
      return signedIn() && request.auth.token.email_verified == true &&
        exists(/databases/$(database)/documents/managers/$(request.auth.token.email.lower()));
    }
    function isOwner() { return signedIn() && request.auth.token.email_verified == true && request.auth.token.email == 'unitedmodelsindia@gmail.com'; }
    function staff() { return isAdmin() || isMgr(); }

    match /users/{uid}       { allow read, write: if me(uid) || isAdmin(); }
    match /brands/{uid}      { allow read, write: if me(uid) || staff(); }
    match /models/{uid}      { allow read: if signedIn(); allow write: if me(uid) || staff(); }
    match /private/{uid}     { allow read, write: if me(uid) || isAdmin(); }
    match /photos/{uid}      { allow read: if signedIn(); allow write: if me(uid) || staff(); }
    match /busy/{uid}        { allow read: if signedIn(); allow write: if me(uid) || staff(); }
    match /likes/{uid}       { allow read, write: if me(uid) || staff(); }
    match /blocked/{uid}     { allow read: if me(uid) || staff(); allow write: if isAdmin(); }
    match /managers/{email}  { allow read: if isAdmin() || (signedIn() && request.auth.token.email.lower() == email); allow create, update: if isAdmin(); allow delete: if isOwner(); }
    match /settings/{id}     { allow read: if signedIn(); allow write: if isAdmin(); }
    match /notes/{id}        { allow read, write: if isAdmin(); }
    match /logs/{id}         { allow create: if signedIn(); allow read: if isAdmin(); }
    match /reports/{id}      { allow create: if real(); allow read, update: if staff(); }
    match /requirements/{id} {
      allow create: if real() && request.resource.data.cid == request.auth.uid;
      allow read: if signedIn();
      allow update: if staff() || (signedIn() && resource.data.cid == request.auth.uid && request.resource.data.cid == resource.data.cid && request.resource.data.status == resource.data.status);
      allow delete: if staff();
    }
    match /apps/{id} {
      allow create: if real() && request.resource.data.mid == request.auth.uid && id == request.resource.data.oid + '_' + request.auth.uid;
      allow read: if staff() || (signedIn() && (resource.data.mid == request.auth.uid || resource.data.cid == request.auth.uid));
      allow delete: if staff() || (signedIn() && resource.data.mid == request.auth.uid);
    }
    match /suggestions/{id}  { allow read: if staff() || (signedIn() && resource.data.cid == request.auth.uid); allow write: if staff(); }
    match /bookings/{id}     {
      allow read: if staff() || (signedIn() && (resource.data.cid == request.auth.uid || resource.data.mid == request.auth.uid));
      allow write: if staff();
      allow update: if signedIn() && resource.data.mid == request.auth.uid && resource.data.status == 'posted' && request.resource.data.status in ['accepted','declined'] && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','rt']);
    }
    match /posts/{id}        { allow read: if staff() || (signedIn() && resource.data.mid == request.auth.uid); allow write: if staff(); }
    function clean(t) {
      return t is string && t.size() > 0 && t.size() <= 500 &&
        !t.lower().matches('(?s).*(([0-9][^a-z0-9]{0,2}){3}[0-9]|https?:|www[.]|[.](com|in|me|net|org|co)([^a-z]|$)|@|₹|[$]|(^|[^a-z])rs([^a-z]|$)|rupee|upi|gpay|paytm|phonepe|whatsapp|wa[.]me|insta|telegram|snapchat|number|mobile|call me|cash|payment|advance|paisa|paise).*');
    }
    function inChat(id) { return signedIn() && (id.split('_')[0] == request.auth.uid || id.split('_')[1] == request.auth.uid); }
    match /chats/{id} {
      allow read: if staff() || inChat(id) || (signedIn() && (resource.data.cid == request.auth.uid || resource.data.mid == request.auth.uid));
      allow create: if real() && id == request.auth.uid + '_' + request.resource.data.mid && request.resource.data.cid == request.auth.uid;
      allow update: if staff() || (inChat(id) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['last','at','lastFrom']) && clean(request.resource.data.last));
      match /m/{mid} {
        allow read: if staff() || inChat(id);
        allow create: if real() && inChat(id) && request.resource.data.from == request.auth.uid && clean(request.resource.data.t);
      }
    }
  }
}
